# ─────────────────────────────────────────────────────────────────────────────
# TalkScene — environment template.  Copy to .env; every value has a safe
# default, so an empty .env still boots a fully working stack on mock providers.
# ─────────────────────────────────────────────────────────────────────────────

# App
TS_ENV=dev                       # dev | test | prod
TS_LOG_LEVEL=INFO
TS_SECRET_KEY=dev-only-change-me-in-production
TS_CORS_ORIGINS=http://localhost:3000
TS_PUBLIC_API_URL=http://localhost:8000
TS_ADMIN_TOKEN=                  # required for /v1/admin/* outside dev

# Provider mode: auto = use a live provider when its key is set, else mock.
#                mock = never call the network (used by tests & offline dev)
#                live = fail loudly if no live provider is configured
TS_PROVIDER_MODE=auto

# Storage
DATABASE_URL=sqlite+aiosqlite:///./var/talkscene.db
# DATABASE_URL=postgresql+asyncpg://talkscene:talkscene@localhost:5432/talkscene
REDIS_URL=                       # empty -> in-process cache/limiter (single worker only)
AUDIO_STORAGE=local              # local | s3
AUDIO_DIR=./var/audio
AUDIO_RETENTION_DAYS=30
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=talkscene-audio
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# ── LLM ──────────────────────────────────────────────────────────────────────
# Order matters: first configured provider wins, and the chain always ends
# in an offline placeholder. Add `ollama` to use a local model.
LLM_PROVIDERS=groq,gemini,xai
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_MODEL=llama-3.3-70b-versatile       # roster rotates quarterly - verify in console
GROQ_API_KEY=
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
LLM_XAI_BASE_URL=https://api.x.ai/v1
LLM_XAI_MODEL=grok-3-mini
XAI_API_KEY=
LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_OLLAMA_MODEL=qwen2.5:7b-instruct

# ── STT ──────────────────────────────────────────────────────────────────────
STT_PROVIDERS=groq_whisper,deepgram,azure
STT_GROQ_MODEL=whisper-large-v3-turbo
DEEPGRAM_API_KEY=
STT_DEEPGRAM_MODEL=nova-3

# ── TTS (per-language priority order; `browser` is handled client-side) ──────
TTS_ROUTE_KO=azure,browser
TTS_ROUTE_JA=azure,deepgram,browser
TTS_ROUTE_DE=azure,deepgram,browser
TTS_ROUTE_EN=azure,deepgram,browser
TTS_DEEPGRAM_MODEL=aura-2-thalia-en

# ── Azure Speech (TTS + Pronunciation Assessment) ────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
PRON_PROVIDER=azure              # azure | heuristic

# ── Quotas (per user, per UTC day) ───────────────────────────────────────────
QUOTA_SESSIONS_PER_DAY=3
QUOTA_PLUS_SESSIONS_PER_DAY=0    # 0 = unlimited
QUOTA_HINTS_PER_SESSION=20
QUOTA_PREMIUM_TTS_CHARS_PER_MONTH=40000
QUOTA_DRILL_SECONDS_PER_MONTH=600
MAX_AUDIO_SECONDS=30
MAX_AUDIO_BYTES=5242880

# ── Web (apps/web) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
