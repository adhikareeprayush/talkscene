{
  "name": "@talkscene/sdk",
  "version": "0.4.0",
  "private": true,
  "description": "TypeScript client generated from docs/openapi.yaml",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi.yaml -o src/schema.d.ts --properties-required-by-default false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.4.2",
    "typescript": "5.6.3"
  }
}
