{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talkscene.app/schemas/scenario-1.json",
  "title": "TalkScene scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "language",
    "level",
    "category",
    "title",
    "summary",
    "persona",
    "setting",
    "user_role",
    "goals",
    "target_vocab",
    "target_grammar",
    "opening_line",
    "turn_limits"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(ko|ja|de|en)-[a-z0-9-]+-(a1|a2|b1|b2)$",
      "description": "Stable slug: <lang>-<topic>-<level>. Never reused for different content."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "enum": [
        "ko",
        "ja",
        "de",
        "en"
      ]
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2"
      ]
    },
    "category": {
      "enum": [
        "travel",
        "food",
        "shopping",
        "health",
        "services",
        "social",
        "work",
        "culture",
        "emergencies"
      ]
    },
    "icon": {
      "type": "string",
      "maxLength": 8,
      "description": "Single emoji for the library card."
    },
    "title": {
      "type": "object",
      "required": [
        "en"
      ],
      "propertyNames": {
        "enum": [
          "en",
          "ko",
          "ja",
          "de"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "style"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1,
          "description": "Register and manner. Drives the politeness linter."
        }
      }
    },
    "setting": {
      "type": "string",
      "minLength": 5
    },
    "user_role": {
      "type": "string",
      "minLength": 5
    },
    "goals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "target_vocab": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "target_grammar": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "opening_line": {
      "type": "string",
      "minLength": 2,
      "description": "Spoken by the AI as turn 0. Pre-cached for TTS."
    },
    "turn_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "default",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 4,
          "maximum": 30
        },
        "default": {
          "type": "integer",
          "minimum": 4,
          "maximum": 30
        },
        "max": {
          "type": "integer",
          "minimum": 4,
          "maximum": 30
        }
      }
    },
    "complications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "useful_phrases": {
      "type": "array",
      "description": "Shown on the pre-chat brief, tappable for audio.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "meaning"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "reading": {
            "type": "string",
            "description": "Romanization / furigana aid."
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "cultural_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "azure": {
          "type": "string"
        },
        "deepgram": {
          "type": "string"
        },
        "browser_hint": {
          "type": "string",
          "description": "BCP-47 tag + gender hint for client-side speechSynthesis."
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "published"
      ],
      "default": "draft"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Native-speaker reviewer handle (content QA step 4, plan §12.2)."
    },
    "learner_register": {
      "enum": [
        "casual",
        "polite",
        "formal"
      ],
      "description": "The politeness level the LEARNER should use - not the character's. Hotel staff speak 합쇼체 to guests, but a guest answering in 해요체 is exactly right. Drives the register check in the report. Omit for English, where register is contextual."
    }
  }
}
